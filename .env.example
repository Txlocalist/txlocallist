# =============================================================================
# TX Localist — environment variables
# Copy this file to `.env` and fill in values before running `npm run dev`.
# Do NOT commit `.env` (it is ignored in .gitignore).
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Explicit deployment class used by safety checks. Vercel supplies VERCEL_ENV.
TX_LOCALIST_ENV="development"

# --- Database (Neon / Postgres) ---------------------------------------------
# Include `?sslmode=require` for Neon.
# Use the pooled URL at runtime and the direct/unpooled URL for migrations.
TX_LOCALIST_DATABASE_ENV="development"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth --------------------------------------------------------------------
# Long random string used to sign session tokens.
SESSION_SECRET=""
# Long random bearer secret automatically sent to authenticated Vercel Cron routes.
CRON_SECRET=""

# --- Billing (Stripe, hosted Checkout) --------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PK=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_EVENT_POST=""
EVENT_POSTING_ENABLED="false"

# --- Reserved rollout switches (safe defaults; do not enable yet) -----------
SUBSCRIPTION_INVOICE_EVENTS_ENABLED="false"
PAST_DUE_ACCESS_ENABLED="false"
EVENT_PAYMENT_RECONCILIATION_MODE="off"
BILLING_MUTATION_FENCE_ENABLED="false"
COMPLIMENTARY_ROLE_MUTATIONS_ENABLED="false"
BUSINESS_PHOTO_UPLOAD_V2_ENABLED="false"
EVENT_IMAGE_UPLOAD_V2_ENABLED="false"
RESUME_UPLOAD_V2_ENABLED="false"
PUBLIC_MEDIA_READ_V2_ENABLED="false"
RESUME_RETENTION_DELETE_ENABLED="false"
LEGACY_BLOB_PROXY_ENABLED="true"
RATE_LIMIT_MODE="observe"
CSP_MODE="report-only"

# --- Email (Resend — added in Phase 5) --------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Texas Localist <hello@txlocalist.com>"

# --- Image uploads (Vercel Blob) --------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Maps --------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- AI search (optional, legacy /results demo) -----------------------------
NEXT_PUBLIC_GEMINI_API_KEY=""

# --- Observability (Phase 0 nice-to-have) -----------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# ---Testing---
