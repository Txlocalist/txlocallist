generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  USER // Standard Localist; creator tools require paid access
  COMPLIMENTARY // Admin-granted Starter creator access without payment
  MANAGER // Operational staff with moderation and read-only user access
  ADMIN // Full platform administration
}

enum RoleTransitionStatus {
  PREVIEWED
  PROCESSING
  PARTIAL
  STRIPE_VERIFIED
  COMPLETED
  NEEDS_ATTENTION
  EXPIRED
}

enum RoleTransitionSubscriptionResult {
  PENDING
  ALREADY_SCHEDULED
  SCHEDULED
  TERMINAL
  FAILED
  AMBIGUOUS
}

enum BusinessStatus {
  DRAFT // Not yet published
  PENDING // Submitted and waiting for admin approval
  DENIED // Reviewed and rejected by admin
  ACTIVE // Live on the directory
  PAUSED // Temporarily hidden by owner
  SUSPENDED // Removed by admin
  ARCHIVED // Soft-deleted
}

enum SubscriptionStatus {
  ACTIVE // Currently paying
  TRIALING // Trial access before the first recurring charge
  PAST_DUE // Payment failed, grace period
  CANCELED // Ended, downgrading to free
  EXPIRED // Trial ended without converting
  INCOMPLETE // Checkout completed but payment/auth is still unresolved
  UNPAID // Past due subscription that exhausted retries
  PAUSED // Subscription paused in Stripe
}

enum EventPostingMethod {
  LEGACY
  SUBSCRIPTION
  ONE_TIME
  ADMIN
}

enum EventPaymentStatus {
  CREATED
  PROCESSING
  PAID
  REVIEW_REQUIRED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
  DISPUTED
}

enum EventReviewDecision {
  APPROVED
  DENIED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  ACTIVE // Live and accepting applications
  CLOSED // Not accepting applications but still visible
  ARCHIVED // Hidden
}

// =============================================================================
// CORE ENTITIES
// =============================================================================

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  role                 Role                @default(USER)
  roleVersion          Int                 @default(0)
  name                 String?
  avatarUrl            String?
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  accountPlanId        String?
  accountPlan          Plan?               @relation("UserAccountPlan", fields: [accountPlanId], references: [id], onDelete: SetNull)
  billingStatus        SubscriptionStatus?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  canceledAt           DateTime?

  // Localist saves, likes, and searches
  favorites      Favorite[]
  likes          Like[]
  eventFavorites EventFavorite[]
  eventLikes     EventLike[]

  // Business ownership is relationship-based, not role-based.
  ownedBusinesses Business[]

  roleTransitionsAsActor  RoleTransitionOperation[] @relation("RoleTransitionActor")
  roleTransitionsAsTarget RoleTransitionOperation[] @relation("RoleTransitionTarget")

  // Events created by this user
  events                    Event[]
  eventPayments             EventPayment[]
  eventImageUploads         EventImageUpload[]
  eventImageUploadRateLimit EventImageUploadRateLimit?
  eventReviews              EventReview[]              @relation("EventReviewReviewer")
  approvedEventRefunds      EventPayment[]             @relation("EventPaymentRefundApprover")

  // Session management
  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]

  @@index([email])
  @@index([role])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([accountPlanId])
  @@index([billingStatus])
  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// DIRECTORY TAXONOMY
// =============================================================================

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  state     String // "Texas", "TX", etc.
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  businesses Business[]

  @@index([slug])
  @@index([state])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String? // Material Icons name or emoji
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  businessCategories BusinessCategory[]

  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  businessTags BusinessTag[]
  events       Event[]

  @@index([slug])
}

// =============================================================================
// BUSINESS LISTINGS (the core product)
// =============================================================================

model Plan {
  id            String  @id @default(cuid())
  name          String // "Free", "Starter", "Pro", "Premium"
  slug          String  @unique
  tier          Int // 0=FREE, 1=TIER1, 2=TIER2, 3=TIER3 (for sorting)
  priceCents    Int // Annual or monthly price in cents (0 for free)
  billingPeriod String  @default("monthly") // "monthly" or "annual"
  stripePriceId String? @unique

  // Feature flags (JSON for extensibility)
  features String @default("{}") // JSON string of feature flags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions Subscription[]
  businesses    Business[]     @relation("CurrentPlan")
  accountUsers  User[]         @relation("UserAccountPlan")

  @@index([slug])
  @@index([tier])
}

model Business {
  id String @id @default(cuid())

  // Identity & slug
  slug        String @unique // "cafe-name-austin"
  name        String
  description String

  // Contact
  phone       String?
  email       String?
  website     String?
  isHiring    Boolean @default(false)
  hiringRoles String  @default("[]")

  // Location
  address     String
  addressName String?
  zipCode     String
  cityId      String
  city        City    @relation(fields: [cityId], references: [id])
  state       String  @default("Texas")
  country     String  @default("USA")
  lat         Float?
  lng         Float?

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Subscription & status
  planId       String?
  plan         Plan?          @relation("CurrentPlan", fields: [planId], references: [id], onDelete: SetNull)
  subscription Subscription?
  status       BusinessStatus @default(DRAFT)
  publishedAt  DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  photos       Photo[]
  categories   BusinessCategory[]
  tags         BusinessTag[]
  socialLinks  SocialLink[]
  hours        BusinessHours[]
  jobs         Job[]
  favorites    Favorite[]
  likes        Like[]
  events       Event[]
  applications BusinessApplication[]

  @@unique([slug, cityId]) // slug is unique per city, not global
  @@index([ownerId])
  @@index([cityId])
  @@index([status])
  @@index([planId])
  @@index([publishedAt])
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId, dayOfWeek])
}

model Photo {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url    String
  width  Int?
  height Int?
  alt    String?
  order  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([businessId, order])
}

model BusinessCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([businessId, categoryId])
  @@index([businessId])
  @@index([categoryId])
}

model BusinessTag {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([businessId, tagId])
  @@index([businessId])
  @@index([tagId])
}

model SocialLink {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform String // "instagram", "facebook", "twitter", "tiktok", etc.
  url      String
  order    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([businessId, platform])
}

model BusinessApplication {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  role           String
  resumeUrl      String
  resumeFileName String?
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([email])
}

// =============================================================================
// SUBSCRIPTIONS & BILLING
// =============================================================================

model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])

  // Stripe integration
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Lifecycle
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  canceledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([planId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

// =============================================================================
// JOBS BOARD
// =============================================================================

model Job {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title       String
  description String

  employmentType EmploymentType
  salaryMin      Int? // in cents
  salaryMax      Int? // in cents
  currency       String         @default("USD")
  isRemote       Boolean        @default(false)

  applyUrl   String? // external application link
  applyEmail String? // internal application email

  status    JobStatus @default(ACTIVE)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([expiresAt])
}

// =============================================================================
// USER ENGAGEMENT
// =============================================================================

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model EventFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model EventLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// =============================================================================
// AUDIT & LOGGING (optional, Phase 10+)
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // User who performed the action (null for system)
  action    String // "create", "update", "publish", "suspend", etc.
  entity    String // "Business", "Job", "Subscription", etc.
  entityId  String // The ID of the entity affected
  meta      String   @default("{}") // JSON string of changes
  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}

model RoleTransitionOperation {
  id                String                       @id @default(cuid())
  actorId           String
  actor             User                         @relation("RoleTransitionActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId      String
  targetUser        User                         @relation("RoleTransitionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  fromRole          Role
  toRole            Role
  targetRoleVersion Int
  status            RoleTransitionStatus         @default(PREVIEWED)
  activeTargetKey   String?                      @unique
  expiresAt         DateTime
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  subscriptions     RoleTransitionSubscription[]

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([status, expiresAt])
}

model RoleTransitionSubscription {
  id                     String                           @id @default(cuid())
  operationId            String
  operation              RoleTransitionOperation          @relation(fields: [operationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String
  sources                String                           @default("[]")
  stripeStatus           String
  amountCents            Int?
  currency               String?
  priorCancelAtPeriodEnd Boolean                          @default(false)
  currentPeriodEnd       DateTime?
  result                 RoleTransitionSubscriptionResult @default(PENDING)
  attemptCount           Int                              @default(0)
  stripeRequestId        String?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@unique([operationId, stripeSubscriptionId])
  @@index([stripeSubscriptionId])
  @@index([result])
}

// =============================================================================
// EVENTS
// =============================================================================

model Event {
  id String @id @default(cuid())

  title       String
  description String
  imageUrl    String

  // Venue / location
  addressName String
  address     String
  zipCode     String
  city        String
  state       String
  country     String @default("US")

  // Optional link to a Business listing
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Creator
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Tags (reuse existing Tag table via join)
  tags      Tag[]
  favorites EventFavorite[]
  likes     EventLike[]

  // Schedule (optional for future use)
  startDate DateTime?
  endDate   DateTime?
  timezone  String    @default("America/Chicago")
  eventUrl  String?

  status             EventStatus              @default(PENDING)
  postingMethod      EventPostingMethod       @default(LEGACY)
  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason EventCancellationReason?

  payments     EventPayment[]
  imageUploads EventImageUpload[]
  reviews      EventReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
  @@index([creatorId])
  @@index([businessId])
  @@index([status, createdAt])
  @@index([status, endDate])
  @@index([postingMethod])
}

model EventPayment {
  /// CREATED/PROCESSING rows are unique per event through the partial index in
  /// migration 20260810001000_one_active_event_checkout.
  id      String             @id @default(cuid())
  eventId String
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status  EventPaymentStatus @default(CREATED)

  stripePriceId           String
  stripeCustomerId        String?
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  stripeRefundId          String?   @unique
  stripeDisputeId         String?
  stripeDisputeStatus     String?
  amountCents             Int
  chargedAmountCents      Int?
  taxAmountCents          Int?
  currency                String    @default("usd")
  eventStartDate          DateTime?
  eventEndDate            DateTime?
  checkoutExpiresAt       DateTime?
  paidAt                  DateTime?
  refundedAt              DateTime?
  refundedAmountCents     Int       @default(0)
  stripeRefundCreatedAt   DateTime?
  stripeRefundStatus      String?
  refundApprovedById      String?
  refundApprovedBy        User?     @relation("EventPaymentRefundApprover", fields: [refundApprovedById], references: [id], onDelete: SetNull)
  refundApprovedAt        DateTime?
  refundReason            String?
  failureReason           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([stripePriceId])
  @@index([stripeCustomerId])
  @@index([refundApprovedById])
}

model EventReview {
  id         String              @id @default(cuid())
  eventId    String
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?               @relation("EventReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decision   EventReviewDecision
  comment    String?
  createdAt  DateTime            @default(now())

  @@index([eventId, createdAt])
  @@index([reviewerId])
}

model EventImageUpload {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  url              String    @unique
  pathname         String    @unique
  contentType      String
  sizeBytes        Int
  createdAt        DateTime  @default(now())
  readyAt          DateTime?
  claimedAt        DateTime?
  cleanupStartedAt DateTime?
  cleanupAttempts  Int       @default(0)
  cleanupError     String?

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([eventId, createdAt, cleanupStartedAt])
}

model EventImageUploadRateLimit {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStartedAt DateTime
  attempts        Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([windowStartedAt])
}

model StripeWebhookEvent {
  id                  String    @id
  type                String
  attempts            Int       @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([processedAt])
  @@index([processingStartedAt])
}

enum EventStatus {
  PENDING
  DENIED
  PUBLISHED
  DRAFT
  CANCELLED
}

enum EventCancellationReason {
  ORGANIZER
  ADMIN
  PAYMENT_REFUND
  PAYMENT_DISPUTE
}
