{
  "name": "tx-localist",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:verify": "node scripts/verify-runtime-config.mjs",
    "env:verify:production": "node scripts/verify-runtime-config.mjs --environment=production",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "npm run env:verify && prisma migrate deploy",
    "db:status": "npm run env:verify && prisma migrate status",
    "db:seed-cities": "node scripts/seed-cities.mjs",
    "db:seed-categories": "node scripts/seed-categories.mjs",
    "db:seed-plans": "node scripts/seed-plans.mjs",
    "db:seed-events": "node scripts/seed-event-data.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:seed-tags": "node scripts/seed-event-tags.mjs",
    "db:seed-test-users": "node scripts/seed-test-users.mjs",
    "db:seed-italian": "node scripts/seed-italian-test.mjs",
    "db:seed-local-businesses": "node scripts/seed-local-businesses.mjs",
    "db:seed-all": "npm run db:seed-cities && npm run db:seed-categories && npm run db:seed-plans && npm run db:seed-events && npm run db:seed-local-businesses",
    "stripe:setup-catalog": "npm run env:verify && node scripts/setup-stripe-catalog.mjs",
    "stripe:webhook:listen": "node scripts/listen-stripe-webhook.mjs",
    "stripe:webhook:check": "node scripts/verify-stripe-webhook-config.mjs",
    "stripe:webhook:replay-sandbox": "node scripts/replay-sandbox-stripe-webhook.mjs",
    "event-posting:verify-readiness": "node scripts/verify-event-posting-readiness.mjs",
    "event-posting:verify-sandbox-payment": "node scripts/verify-sandbox-event-payment.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@next/env": "16.2.2",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@vercel/blob": "^2.3.3",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "resend": "^4.5.1",
    "stripe": "^22.2.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^7.7.0",
    "vitest": "^4.1.10"
  }
}
